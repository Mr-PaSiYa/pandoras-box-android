<?xml version="1.0" encoding="utf-8"?>
<!-- Soft premium dark background with subtle ambient glows -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base deep navy/black -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#090D16" />
        </shape>
    </item>

    <!-- Soft indigo glow from top-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="520dp"
                android:centerX="0.0"
                android:centerY="0.0"
                android:startColor="#336366F1"
                android:endColor="#00090D16" />
        </shape>
    </item>

    <!-- Soft purple glow from top-right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="480dp"
                android:centerX="1.0"
                android:centerY="0.05"
                android:startColor="#288B5CF6"
                android:endColor="#00090D16" />
        </shape>
    </item>

    <!-- Very subtle bottom cyan accent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="0.5"
                android:centerY="1.1"
                android:startColor="#1806B6D4"
                android:endColor="#00090D16" />
        </shape>
    </item>

</layer-list>
