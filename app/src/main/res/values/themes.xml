<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PandorasBox" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app_premium</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/background_dark</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.PandorasBox.Splash" parent="Theme.PandorasBox">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowSplashScreenBackground">@color/background_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_system_placeholder</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Corner10" parent="">
        <item name="cornerSize">10dp</item>
    </style>
</resources>
