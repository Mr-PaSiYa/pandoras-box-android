<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingBottom="90dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="ARCHIVE"
            android:textColor="?attr/appAccent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Download History"
            android:textColor="?attr/appTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your past video and audio downloads."
            android:textColor="?attr/appTextSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_history_view"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="Compact list"
                android:textAllCaps="false"
                android:textColor="?attr/appTextPrimary"
                android:textSize="12sp"
                app:backgroundTint="?attr/appCard"
                app:cornerRadius="10dp"
                app:strokeColor="?attr/appStroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="Clear all"
                android:textAllCaps="false"
                android:textColor="@color/accent_rose"
                android:textSize="12sp"
                app:backgroundTint="#2D1517"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_trash"
                app:iconTint="@color/accent_rose"
                app:strokeColor="#5F1D24"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tv_history_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Your downloads will appear here."
            android:textColor="?attr/appTextSecondary"
            android:textSize="14sp" />
    </FrameLayout>

</LinearLayout>
