<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/splash_mark"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_splash_mark">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:fontFamily="sans-serif-light"
                android:gravity="bottom|center_horizontal"
                android:text="P"
                android:textColor="@color/accent_blue_soft"
                android:textSize="74sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.16"
                android:text="BOX"
                android:textColor="@color/accent_blue"
                android:textSize="15sp" />
        </FrameLayout>

        <View
            android:id="@+id/splash_accent_line"
            android:layout_width="76dp"
            android:layout_height="3dp"
            android:layout_marginTop="26dp"
            android:background="@color/accent_blue_strong" />

        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.17"
            android:text="PANDORA'S BOX"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save something worth keeping."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
